# CSFloat API key — required for fetching listings and sale history
# Get yours at https://csfloat.com/developers
CSFLOAT_API_KEY=your_api_key_here

# DMarket API keys — optional, enables DMarket listing fetch + buy
# Generate at https://dmarket.com (Account Settings → Trading API)
DMARKET_PUBLIC_KEY=your_public_key_hex
DMARKET_SECRET_KEY=your_secret_key_hex

# Steam Web API key — required for Steam login
# Get yours at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key

# Session secret — random string for cookie signing
SESSION_SECRET=change_this_to_random_string

# Base URL — used for Steam OpenID callback
BASE_URL=http://localhost:3001

# Admin Steam ID — gets full access to daemon modal, raw stats
ADMIN_STEAM_ID=your_steam_id_here

# Reprice buyer fee. Unset or false keeps the fee on input prices (matches the
# PR 166 backfill). Set to true only to restore the pre-backfill raw-price reprice.
REPRICE_DROPS_BUYER_FEE=false

# ── Conversion tracking (all optional; every tracker is OFF while its var is empty) ──
# Browser-side ids are baked into <head> at BUILD time: set them, then `npm run build`.
# Server-side secrets are read at runtime: set them, then restart the API (pm2 restart).
# GA4 measurement id (G-XXXXXXXXXX). Enables browser GA4 events. Mark begin_checkout,
# purchase, sign_up, and calculator_complete as key events. Do not mark view_item, login, or cta_click.
GA4_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret (GA4 → Admin → Data streams → Measurement Protocol).
# With GA4_MEASUREMENT_ID, the Stripe webhook sends `purchase` server-side and the
# success page stops sending it, so GA4 counts each purchase exactly once.
GA4_API_SECRET=
# Meta Pixel / dataset id (digits only). Enables the browser Pixel (PageView + conversion events).
META_PIXEL_ID=
# Meta Conversions API access token. With META_PIXEL_ID, the Stripe webhook sends
# `Purchase` server-side with the same event_id as the browser Pixel (Meta dedupes).
META_CAPI_TOKEN=
# Meta domain verification code (the content="..." value only). Fallback for the DNS TXT
# record; adds <meta name="facebook-domain-verification"> to <head> at build time.
META_DOMAIN_VERIFICATION=
# QA only — leave empty in normal operation.
# Events Manager → Test events → server test code; routes CAPI events to the Test events tab.
META_TEST_EVENT_CODE=
# Set to 1 to flag server-side GA4 purchase events for DebugView.
GA4_DEBUG_MODE=
