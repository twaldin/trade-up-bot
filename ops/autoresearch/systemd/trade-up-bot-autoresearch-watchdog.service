[Unit]
Description=TradeUpBot autoresearch heartbeat freshness watchdog

[Service]
Type=oneshot
WorkingDirectory=/home/tim/omp-firstmate/projects/trade-up-bot
Environment="PATH=/home/tim/.nvm/versions/node/v24.18.0/bin:/home/tim/.bun/bin:/home/tim/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/trade-up-bot/autoresearch.env
ExecStart=/usr/bin/env node /home/tim/omp-firstmate/projects/trade-up-bot/ops/autoresearch/bin/watchdog.mjs
TimeoutStartSec=1min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/trade-up-bot/autoresearch
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
