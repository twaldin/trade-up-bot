# Required host-local configuration. Install as mode 0600, owned by tim:
#   ~/.config/trade-up-bot/autoresearch.env
# Use the dedicated localhost-only role/database; never point this at production.
TEST_DATABASE_URL=postgresql://tradeupbot_test:generated-url-safe-password@127.0.0.1:5432/tradeupbot_test

# Optional non-secret overrides:
# AUTORESEARCH_MODEL=openai/gpt-5.6
# AUTORESEARCH_OMP_PROFILE=default
# AUTORESEARCH_MAX_TIME=5h30m
# AUTORESEARCH_STATE_DIR=/home/tim/.local/state/trade-up-bot/autoresearch
# AUTORESEARCH_VPS_HOST=root@178.156.239.58
# AUTORESEARCH_VPS_REPO=/opt/trade-up-bot
# AUTORESEARCH_DAILY_MAX_AGE_SECONDS=93600
# AUTORESEARCH_MONITOR_MAX_AGE_SECONDS=5400
# AUTORESEARCH_WATCHDOG_MAX_AGE_SECONDS=1800
